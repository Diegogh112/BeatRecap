# ─── Aplicación ───────────────────────────────────────────────────────────────
APP_NAME=FaceSwap AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-use-a-long-random-string

# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./faceswap.db
# Para PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/faceswap

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Almacenamiento ───────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
THUMBNAIL_DIR=thumbnails
MODEL_DIR=models

# ─── Límites de video ─────────────────────────────────────────────────────────
MAX_VIDEO_DURATION=300        # segundos (5 min)
MAX_VIDEO_SIZE_MB=2048        # MB (2 GB)
ALLOWED_VIDEO_FORMATS=mp4,mov,avi

# ─── Retención de archivos ────────────────────────────────────────────────────
RETENTION_HOURS=24

# ─── IA / Hardware ────────────────────────────────────────────────────────────
USE_GPU=false                 # true para usar CUDA
INSIGHTFACE_MODEL=buffalo_l   # buffalo_l | buffalo_s
INSWAPPER_MODEL=inswapper_128.onnx
GFPGAN_MODEL=GFPGANv1.4.pth
FACE_DETECT_THRESHOLD=0.5
FACE_CLUSTER_THRESHOLD=0.5

# ── Optimizaciones de velocidad ──────────────────────────────────────────────
SWAP_FRAME_STEP=10
APPLY_ENHANCEMENT=false
FACE_DET_SIZE=320    # umbral de similitud para agrupar identidades

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
